{
  "name": "maya-classroom",
  "version": "1.0.0",
  "private": true,
  "description": "Maya Classroom \u2014 Plataforma de aulas virtuales multiempresa (Angular 22 + NestJS 11 + MongoDB Atlas)",
  "license": "MIT",
  "engines": {
    "node": ">=22.22.3",
    "npm": ">=10"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspace @maya/shared && npm run build --workspace @maya/api && npm run build --workspace @maya/web",
    "build:shared": "npm run build --workspace @maya/shared",
    "build:api": "npm run build --workspace @maya/api",
    "build:web": "npm run build --workspace @maya/web",
    "dev": "concurrently -n api,web -c magenta,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run start:dev --workspace @maya/api",
    "dev:web": "npm run start --workspace @maya/web",
    "seed": "npm run seed --workspace @maya/api",
    "test": "npm run test --workspace @maya/api",
    "lint": "npm run lint --workspace @maya/api"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "~5.9.2"
  }
}
