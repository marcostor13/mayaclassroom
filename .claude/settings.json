{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh",
            "timeout": 600,
            "statusMessage": "Preparando el entorno de Maya Classroom…"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(bun install)",
      "Bash(bun run build:*)",
      "Bash(bun run build)",
      "Bash(bun run lint)",
      "Bash(bun run test)",
      "Bash(bun run seed)",
      "Bash(bun test:*)",
      "Bash(bunx tsc:*)",
      "Bash(bunx eslint:*)",
      "Bash(bunx ng build:*)",
      "Bash(bunx prettier:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git blame:*)",
      "Bash(git stash list)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(find:*)",
      "Bash(rg:*)",
      "Bash(jq:*)",
      "Bash(node --version)",
      "Bash(bun --version)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.development)",
      "Read(./.env.production)",
      "Read(./**/.env)"
    ]
  }
}
