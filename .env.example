# ─────────────────────────────────────────────────────────────────────────────
#  Maya Classroom · variables de entorno
#  Copie este fichero como `.env` en la raíz o en `apps/api/`.
# ─────────────────────────────────────────────────────────────────────────────

# Entorno y servidor
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
APP_NAME=Maya Classroom
API_URL=http://localhost:3000
WEB_URL=http://localhost:4205
API_PREFIX=api
CORS_ORIGINS=http://localhost:4205
LOG_LEVEL=log

# ── MongoDB Atlas ────────────────────────────────────────────────────────────
# Cadena de conexión del clúster (Atlas → Connect → Drivers).
MONGODB_URI=mongodb+srv://USUARIO:CONTRASENA@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=maya_classroom
MONGODB_AUTO_INDEX=true
MONGODB_POOL_SIZE=20
# Servidores DNS (separados por comas) que Node usa para resolver el registro
# SRV de `mongodb+srv://`. Déjelo vacío para usar el resolver del sistema y
# rellénelo solo si el arranque falla con
# `querySrv ECONNREFUSED _mongodb._tcp.<clúster>`, síntoma habitual de una VPN
# o un proxy DNS local que rechaza las consultas SRV.
NODE_DNS_SERVERS=

# ── Autenticación ────────────────────────────────────────────────────────────
# En producción deben ser cadenas aleatorias distintas de al menos 32 caracteres.
JWT_ACCESS_SECRET=cambie-esta-clave-de-acceso-en-produccion
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_SECRET=cambie-esta-clave-de-refresco-en-produccion
JWT_REFRESH_EXPIRES=30d
JWT_ISSUER=maya-classroom
JWT_AUDIENCE=maya-classroom-web

# ── Seguridad ────────────────────────────────────────────────────────────────
THROTTLE_TTL=60000
THROTTLE_LIMIT=300
LOGIN_MAX_ATTEMPTS=8
LOGIN_LOCK_MINUTES=15
REFRESH_TOKEN_ROTATION=true

# ── Acceso de demostración ───────────────────────────────────────────────────
# Con DEMO_ENABLED=true, la pantalla de acceso ofrece ver el escaparate y
# entrar como administrador o como estudiante de la empresa indicada, sin
# credenciales. Es lo que se quiere en el despliegue que enseña la plataforma,
# y lo último que se quiere en el de un cliente: déjelo en false salvo ahí.
DEMO_ENABLED=false
DEMO_TENANT_SLUG=demo

# ── Correo transaccional ─────────────────────────────────────────────────────
# Con MAIL_ENABLED=false los correos se registran en el log (ideal en desarrollo).
MAIL_ENABLED=false
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=Maya Classroom <no-reply@mayaclassroom.app>

# ── Almacenamiento de ficheros ───────────────────────────────────────────────
# «local» guarda en disco (desarrollo, o despliegue con volumen persistente).
# «r2» es Cloudflare R2 y «s3» cualquier otro compatible.
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage
STORAGE_MAX_FILE_SIZE=52428800

# --- Cloudflare R2 (STORAGE_DRIVER=r2) --------------------------------------
# El identificador de cuenta se lee en el panel de R2; con él se compone el
# extremo, así que no hace falta escribirlo aparte.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Dirección pública del bucket: el subdominio r2.dev o, mejor, un dominio
# propio conectado al bucket. Es la base de las URL de logos y portadas, así
# que debe ser accesible SIN sesión. Sin esto, las imágenes no se ven.
R2_PUBLIC_URL=

# --- Otro almacenamiento compatible con S3 (STORAGE_DRIVER=s3) --------------
S3_BUCKET=
S3_REGION=eu-west-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
# Con driver «local» apunta a la propia API; con S3, a la base pública del bucket.
STORAGE_PUBLIC_URL=http://localhost:3000/api/v1/files

# ── Siembra de datos de demostración ─────────────────────────────────────────
SEED_PASSWORD=Maya2026!

# ── Medios de la demostración (opcional) ─────────────────────────────────────
# Clave de la API de Pexels (pexels.com/api). `bun run seed` la usa para
# resolver las direcciones de los vídeos de la demostración —las fotos no la
# necesitan, se componen del identificador—. Sin ella la demostración se
# siembra igual, con imágenes y sin vídeos.
PEXELS_API_KEY=

# ── Aulas en vivo (videoconferencia nativa) ──────────────────────────────────
# El audio y el vídeo viajan directamente entre navegadores (WebRTC): la API
# solo hace de centralita. Lo único que hay que configurar es por dónde
# atraviesan los cortafuegos.
#
# STUN basta en redes domésticas. En redes corporativas con NAT simétrico hace
# falta un TURN (coturn es el habitual) o las conexiones no llegan a
# establecerse: los participantes se ven en la lista y no se oyen entre sí.
LIVE_STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
LIVE_TURN_URLS=
# Opción recomendada: el `static-auth-secret` de coturn. Con él, las
# credenciales TURN se emiten firmadas y caducan solas, en lugar de repartir un
# usuario y una contraseña fijos que cualquiera puede leer en el navegador.
LIVE_TURN_SECRET=
# Alternativa a lo anterior, solo si su TURN no admite el mecanismo REST.
LIVE_TURN_USERNAME=
LIVE_TURN_PASSWORD=
LIVE_TURN_TTL=28800
# Fuerza que todo el tráfico pase por TURN. Útil para comprobar que el TURN
# está bien puesto y en redes que bloquean el tráfico directo. Se ignora si no
# hay ningún TURN configurado.
LIVE_FORCE_RELAY=false

# Aforo por sala. La conferencia es en malla: cada emisor sube una copia por
# asistente, así que con todo el mundo emitiendo lo cómodo son 8-12 personas.
# En formato «clase», donde solo emite quien presenta, aguanta bastante más.
LIVE_MAX_PARTICIPANTS=25

# Grabación. La compone el navegador de quien presenta y la sube por trozos.
# El ensamblado carga el fichero en memoria una vez, así que subir el máximo
# exige subir también la memoria del contenedor.
LIVE_RECORDING_CHUNK_SIZE=8388608
LIVE_RECORDING_MAX_SIZE=1073741824
# Carpeta donde se acumulan los trozos hasta ensamblar la grabación. Necesita
# ser escribible y sobrevivir a la duración de una clase.
LIVE_RECORDING_STAGING_PATH=./storage/.live-chunks
